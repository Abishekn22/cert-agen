# Ollama local AI configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
